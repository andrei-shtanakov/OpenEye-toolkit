#!/usr/bin/env bash
set -euo pipefail

die() { echo "openeye-pyds-exec: $*" >&2; exit 2; }
[[ $# -gt 0 ]] || die 'usage: openeye-pyds-exec <command> [args...]'
[[ ${PYTHONDS_VERSION:-} == v1.6 ]] || die 'load PythonDS/v1.6 first'
: "${PYTHONDS_CONTAINER:?load PythonDS/v1.6 first}"
command -v pyds-exec >/dev/null || die 'pyds-exec is not on PATH'

# Resolve from the installed script, so EasyBuild sanity also works before the
# generated module has been loaded. Installation paths must not contain : or ,.
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
license=${OE_LICENSE:-/busdev/cadd/RHEL9/license/openeye/oe_license.txt}
[[ -d $root/python/openeye ]] || die "toolkit missing in $root/python"
[[ -r $license && -f $license ]] || die "license file is not readable: $license"
license_dir=$(cd -- "$(dirname -- "$license")" && pwd -P)
license_name=$(basename -- "$license")
for path in "$root" "$license_dir"; do
    [[ $path != *:* && $path != *,* ]] || die 'bind paths must not contain colon or comma'
done

# Do not inherit host Python search paths. Set both runtime namespaces to the
# same values, including on Apptainer installations with legacy compatibility.
export SINGULARITYENV_PYTHONPATH=/opt/openeye-toolkits/python
export APPTAINERENV_PYTHONPATH=$SINGULARITYENV_PYTHONPATH
export SINGULARITYENV_OE_LICENSE="/opt/openeye-license/$license_name"
export APPTAINERENV_OE_LICENSE=$SINGULARITYENV_OE_LICENSE
bindings="$root:/opt/openeye-toolkits:ro,$license_dir:/opt/openeye-license:ro"
export SINGULARITY_BINDPATH="${SINGULARITY_BINDPATH:+$SINGULARITY_BINDPATH,}$bindings"
export APPTAINER_BINDPATH="${APPTAINER_BINDPATH:+$APPTAINER_BINDPATH,}$bindings"
# *_BIND takes priority over *_BINDPATH; append there too if already present.
if [[ -n ${SINGULARITY_BIND:-} ]]; then export SINGULARITY_BIND="$SINGULARITY_BIND,$bindings"; fi
if [[ -n ${APPTAINER_BIND:-} ]]; then export APPTAINER_BIND="$APPTAINER_BIND,$bindings"; fi
exec pyds-exec "$@"
